{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "latestVersion", "versions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "latestVersion": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "state", "projects"],
        "properties": {
          "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
          "state": {"enum": ["development", "released"]},
          "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}}
        }
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "commitSha", "generatedAt", "workflowRunId", "artifact"],
      "properties": {
        "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "workflowRunId": {"type": "integer", "minimum": 1},
        "artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "sha256", "sizeBytes"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 104857600}
          }
        }
      }
    }
  }
}
